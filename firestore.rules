rules_version = '2';

// Each signed-in person reads and writes only their own items (ADR-006). An item is one document:
// a problem, an attempt, a study, a day's plan, the backlog, or the settings.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid}/items/{item} {
      allow read: if owner(uid);
      // Deleting is a write too (data: null), so other devices learn about it; documents are never removed.
      allow create, update: if owner(uid)
        && item.size() <= 120
        && request.resource.data.keys().hasOnly(['data', 'schema', 'updatedAt'])
        && request.resource.data.schema is int
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
